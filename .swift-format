{
  "version": 1,
  "indentation": { "spaces": 4 },
  "lineLength": 160,
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeEachArgument": false,
  "rules": {
    "AlwaysUseLowerCamelCase": false,
    "OrderedImports": true,
    "UseLetInEveryBoundCaseVariable": false
  }
}
